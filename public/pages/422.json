{"page":422,"surahs":[33],"juz":22,"rubs":[169],"lines":[{"t":"text","w":[["ﱁ ﱂ","33:31"],["ﱃ","33:31"],["ﱄ","33:31"],["ﱅ","33:31"],["ﱆ","33:31"],["ﱇ","33:31"],["ﱈ","33:31"],["ﱉ","33:31"]],"x":"۞ وَمَن يَقْنُتْ مِنكُنَّ لِلَّهِ وَرَسُولِهِۦ وَتَعْمَلْ صَـٰلِحًۭا نُّؤْتِهَآ"},{"t":"text","w":[["ﱊ","33:31"],["ﱋ","33:31"],["ﱌ","33:31"],["ﱍ","33:31"],["ﱎ","33:31"],["ﱏ","33:31"],["ﱐ","33:31"],["ﱑ","33:32"],["ﱒ","33:32"]],"x":"أَجْرَهَا مَرَّتَيْنِ وَأَعْتَدْنَا لَهَا رِزْقًۭا كَرِيمًۭا ﴿٣١﴾ يَـٰنِسَآءَ ٱلنَّبِىِّ"},{"t":"text","w":[["ﱓ","33:32"],["ﱔ","33:32"],["ﱕ","33:32"],["ﱖ","33:32"],["ﱗ","33:32"],["ﱘﱙ","33:32"],["ﱚ","33:32"],["ﱛ","33:32"],["ﱜ","33:32"]],"x":"لَسْتُنَّ كَأَحَدٍۢ مِّنَ ٱلنِّسَآءِ ۚ إِنِ ٱتَّقَيْتُنَّ فَلَا تَخْضَعْنَ بِٱلْقَوْلِ"},{"t":"text","w":[["ﱝ","33:32"],["ﱞ","33:32"],["ﱟ","33:32"],["ﱠ","33:32"],["ﱡ","33:32"],["ﱢ","33:32"],["ﱣ","33:32"],["ﱤ","33:32"],["ﱥ","33:32"],["ﱦ","33:33"]],"x":"فَيَطْمَعَ ٱلَّذِى فِى قَلْبِهِۦ مَرَضٌۭ وَقُلْنَ قَوْلًۭا مَّعْرُوفًۭا ﴿٣٢﴾ وَقَرْنَ"},{"t":"text","w":[["ﱧ","33:33"],["ﱨ","33:33"],["ﱩ","33:33"],["ﱪ","33:33"],["ﱫ","33:33"],["ﱬ","33:33"],["ﱭﱮ","33:33"],["ﱯ","33:33"]],"x":"فِى بُيُوتِكُنَّ وَلَا تَبَرَّجْنَ تَبَرُّجَ ٱلْجَـٰهِلِيَّةِ ٱلْأُولَىٰ ۖ وَأَقِمْنَ"},{"t":"text","w":[["ﱰ","33:33"],["ﱱ","33:33"],["ﱲ","33:33"],["ﱳ","33:33"],["ﱴ","33:33"],["ﱵﱶ","33:33"],["ﱷ","33:33"]],"x":"ٱلصَّلَوٰةَ وَءَاتِينَ ٱلزَّكَوٰةَ وَأَطِعْنَ ٱللَّهَ وَرَسُولَهُۥٓ ۚ إِنَّمَا"},{"t":"text","w":[["ﱸ","33:33"],["ﱹ","33:33"],["ﱺ","33:33"],["ﱻ","33:33"],["ﱼ","33:33"],["ﱽ","33:33"],["ﱾ","33:33"],["ﱿ","33:33"]],"x":"يُرِيدُ ٱللَّهُ لِيُذْهِبَ عَنكُمُ ٱلرِّجْسَ أَهْلَ ٱلْبَيْتِ وَيُطَهِّرَكُمْ"},{"t":"text","w":[["ﲀ","33:33"],["ﲁ","33:33"],["ﲂ","33:34"],["ﲃ","33:34"],["ﲄ","33:34"],["ﲅ","33:34"],["ﲆ","33:34"],["ﲇ","33:34"]],"x":"تَطْهِيرًۭا ﴿٣٣﴾ وَٱذْكُرْنَ مَا يُتْلَىٰ فِى بُيُوتِكُنَّ مِنْ"},{"t":"text","w":[["ﲈ","33:34"],["ﲉ","33:34"],["ﲊﲋ","33:34"],["ﲌ","33:34"],["ﲍ","33:34"],["ﲎ","33:34"],["ﲏ","33:34"],["ﲐ","33:34"],["ﲑ","33:34"]],"x":"ءَايَـٰتِ ٱللَّهِ وَٱلْحِكْمَةِ ۚ إِنَّ ٱللَّهَ كَانَ لَطِيفًا خَبِيرًا ﴿٣٤﴾"},{"t":"text","w":[["ﲒ","33:35"],["ﲓ","33:35"],["ﲔ","33:35"],["ﲕ","33:35"],["ﲖ","33:35"]],"x":"إِنَّ ٱلْمُسْلِمِينَ وَٱلْمُسْلِمَـٰتِ وَٱلْمُؤْمِنِينَ وَٱلْمُؤْمِنَـٰتِ"},{"t":"text","w":[["ﲗ","33:35"],["ﲘ","33:35"],["ﲙ","33:35"],["ﲚ","33:35"],["ﲛ","33:35"]],"x":"وَٱلْقَـٰنِتِينَ وَٱلْقَـٰنِتَـٰتِ وَٱلصَّـٰدِقِينَ وَٱلصَّـٰدِقَـٰتِ وَٱلصَّـٰبِرِينَ"},{"t":"text","w":[["ﲜ","33:35"],["ﲝ","33:35"],["ﲞ","33:35"],["ﲟ","33:35"]],"x":"وَٱلصَّـٰبِرَٰتِ وَٱلْخَـٰشِعِينَ وَٱلْخَـٰشِعَـٰتِ وَٱلْمُتَصَدِّقِينَ"},{"t":"text","w":[["ﲠ","33:35"],["ﲡ","33:35"],["ﲢ","33:35"],["ﲣ","33:35"]],"x":"وَٱلْمُتَصَدِّقَـٰتِ وَٱلصَّـٰٓئِمِينَ وَٱلصَّـٰٓئِمَـٰتِ وَٱلْحَـٰفِظِينَ"},{"t":"text","w":[["ﲤ","33:35"],["ﲥ","33:35"],["ﲦ","33:35"],["ﲧ","33:35"],["ﲨ","33:35"]],"x":"فُرُوجَهُمْ وَٱلْحَـٰفِظَـٰتِ وَٱلذَّٰكِرِينَ ٱللَّهَ كَثِيرًۭا"},{"t":"text","w":[["ﲩ","33:35"],["ﲪ","33:35"],["ﲫ","33:35"],["ﲬ","33:35"],["ﲭ","33:35"],["ﲮ","33:35"],["ﲯ","33:35"],["ﲰ","33:35"]],"x":"وَٱلذَّٰكِرَٰتِ أَعَدَّ ٱللَّهُ لَهُم مَّغْفِرَةًۭ وَأَجْرًا عَظِيمًۭا ﴿٣٥﴾"}]}